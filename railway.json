{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt --break-system-packages"
  },
  "deploy": {
    "startCommand": "python app.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}