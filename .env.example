# ============================================================
# Octuplex 环境变量配置模板
# 使用说明：复制此文件为 .env，修改各项参数后保存
# 安全警告：.env 文件包含敏感密钥，切勿提交到公开仓库
# ============================================================

# ---- 大模型API配置（必填） ----
# 主模型配置（默认使用代码能力较强的模型，国内可直连）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL_NAME=deepseek-chat
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7

# 高性能模型（用于复杂代码/长文档/多步骤任务，可选）
LLM_PREMIUM_BASE_URL=https://api.deepseek.com/v1
LLM_PREMIUM_API_KEY=sk-your-api-key-here
LLM_PREMIUM_MODEL_NAME=deepseek-reasoner
LLM_PREMIUM_MAX_TOKENS=32768

# 轻量模型（用于简单闲聊/路由判断，可选）
LLM_LITE_BASE_URL=https://api.deepseek.com/v1
LLM_LITE_API_KEY=sk-your-api-key-here
LLM_LITE_MODEL_NAME=deepseek-chat
LLM_LITE_MAX_TOKENS=4096

# ---- 联网搜索配置 ----
# 可选：搜索引擎API密钥（如SerpAPI、Bing等）
SEARCH_API_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
# 搜索域名黑名单，逗号分隔
SEARCH_BLACKLIST_DOMAINS=

# ---- GitHub配置（可选，用于GitHub工具） ----
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_USERNAME=your-github-username
GITHUB_REPO=your-repo-name

# ---- 向量数据库配置（ChromaDB） ----
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_MEMORY=octuplex_long_term_memory
CHROMA_COLLECTION_RAG=octuplex_rag_knowledge

# ---- 沙盒执行环境配置 ----
# 沙盒工作目录（所有文件操作限制在此目录下）
SANDBOX_WORK_DIR=./sandbox_workspace
# 单次代码执行超时（秒）
SANDBOX_EXEC_TIMEOUT=300
# 单次代码执行内存限制（MB）
SANDBOX_MEMORY_LIMIT=512
# 高危命令黑名单，逗号分隔
SANDBOX_BANNED_COMMANDS=rm -rf /,sudo,chmod 777,mount,mkfs,dd if=,shutdown,reboot,init

# ---- 安全配置 ----
# 前端域名白名单（CORS），逗号分隔，仅允许你的GitHub Pages域名
CORS_ORIGINS=https://你的用户名.github.io
# 预留API密钥（前端请求时携带，用于简单鉴权，可选）
API_SECRET_KEY=octuplex-secret-change-me

# ---- 限额配置 ----
# 每日Token消耗上限（0表示不限制）
DAILY_TOKEN_LIMIT=1000000
# 单次会话Token消耗上限（0表示不限制）
SESSION_TOKEN_LIMIT=200000
# 单次任务最大工具调用轮次
MAX_TOOL_CALLS_PER_TASK=50
# 单次任务最大重试次数
MAX_RETRIES_PER_TASK=5

# ---- 日志配置 ----
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=7

# ---- 服务配置 ----
# FastAPI服务端口（Hugging Face默认使用7860）
SERVER_PORT=7860
SERVER_HOST=0.0.0.0
# 是否启用Gradio管理面板
ENABLE_GRADIO=true